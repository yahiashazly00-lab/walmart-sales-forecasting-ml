const {
  Document, Packer, Paragraph, TextRun, Table, TableRow, TableCell,
  ImageRun, Header, Footer, AlignmentType, HeadingLevel, BorderStyle,
  WidthType, ShadingType, VerticalAlign, PageNumber, PageBreak,
  LevelFormat, TableOfContents
} = require('docx');
const fs = require('fs');

const CONTENT_W = 9360; // US Letter 1" margins
const COL2A = 4680;
const COL2B = 4680;
const border = { style: BorderStyle.SINGLE, size: 1, color: "CCCCCC" };
const borders = { top: border, bottom: border, left: border, right: border };
const headerBorder = { style: BorderStyle.SINGLE, size: 1, color: "1F4E79" };

// --- helpers ---
function h1(text) {
  return new Paragraph({
    heading: HeadingLevel.HEADING_1,
    spacing: { before: 360, after: 120 },
    children: [new TextRun({ text, bold: true, size: 32, font: "Arial", color: "1F4E79" })]
  });
}
function h2(text) {
  return new Paragraph({
    heading: HeadingLevel.HEADING_2,
    spacing: { before: 240, after: 80 },
    children: [new TextRun({ text, bold: true, size: 26, font: "Arial", color: "2E75B6" })]
  });
}
function h3(text) {
  return new Paragraph({
    heading: HeadingLevel.HEADING_3,
    spacing: { before: 180, after: 60 },
    children: [new TextRun({ text, bold: true, size: 24, font: "Arial", color: "2E74B5" })]
  });
}
function body(text, opts = {}) {
  return new Paragraph({
    spacing: { after: 120 },
    alignment: opts.center ? AlignmentType.CENTER : AlignmentType.JUSTIFIED,
    children: [new TextRun({ text, size: 22, font: "Arial", ...opts })]
  });
}
function bold(text) {
  return new TextRun({ text, bold: true, size: 22, font: "Arial" });
}
function normal(text) {
  return new TextRun({ text, size: 22, font: "Arial" });
}
function italic(text) {
  return new TextRun({ text, italics: true, size: 22, font: "Arial" });
}
function mixed(...runs) {
  return new Paragraph({ spacing: { after: 120 }, alignment: AlignmentType.JUSTIFIED, children: runs });
}
function caption(text) {
  return new Paragraph({
    spacing: { before: 40, after: 160 },
    alignment: AlignmentType.CENTER,
    children: [new TextRun({ text, italics: true, size: 20, font: "Arial", color: "595959" })]
  });
}
function bullet(text, sub = false) {
  return new Paragraph({
    numbering: { reference: "bullets", level: sub ? 1 : 0 },
    spacing: { after: 60 },
    children: [new TextRun({ text, size: 22, font: "Arial" })]
  });
}
function numbered(text, lvl = 0) {
  return new Paragraph({
    numbering: { reference: "numbers", level: lvl },
    spacing: { after: 60 },
    children: [new TextRun({ text, size: 22, font: "Arial" })]
  });
}
function spacer(before = 120) {
  return new Paragraph({ spacing: { before, after: 0 }, children: [new TextRun("")] });
}
function hrule() {
  return new Paragraph({
    border: { bottom: { style: BorderStyle.SINGLE, size: 6, color: "2E75B6", space: 1 } },
    spacing: { before: 120, after: 120 },
    children: [new TextRun("")]
  });
}
function pageBreak() {
  return new Paragraph({ children: [new PageBreak()] });
}

function img(path, widthPx, heightPx, maxWin = 8800) {
  const data = fs.readFileSync(path);
  const scale = Math.min(1, maxWin / widthPx);
  return new Paragraph({
    alignment: AlignmentType.CENTER,
    spacing: { before: 120, after: 60 },
    children: [new ImageRun({
      type: "png",
      data,
      transformation: { width: Math.round(widthPx * scale * 0.094), height: Math.round(heightPx * scale * 0.094) },
      altText: { title: "Figure", description: "Chart from notebook", name: "chart" }
    })]
  });
}

// --- metric table helper ---
function metricsTable(headers, rows) {
  const colCount = headers.length;
  const colW = Math.floor(CONTENT_W / colCount);
  const cols = headers.map(() => colW);

  return new Table({
    width: { size: CONTENT_W, type: WidthType.DXA },
    columnWidths: cols,
    rows: [
      new TableRow({
        tableHeader: true,
        children: headers.map(h => new TableCell({
          borders,
          width: { size: colW, type: WidthType.DXA },
          shading: { fill: "1F4E79", type: ShadingType.CLEAR },
          margins: { top: 80, bottom: 80, left: 120, right: 120 },
          children: [new Paragraph({
            alignment: AlignmentType.CENTER,
            children: [new TextRun({ text: h, bold: true, size: 20, font: "Arial", color: "FFFFFF" })]
          })]
        }))
      }),
      ...rows.map((row, ri) => new TableRow({
        children: row.map((cell, ci) => new TableCell({
          borders,
          width: { size: colW, type: WidthType.DXA },
          shading: { fill: ri % 2 === 0 ? "EBF3FB" : "FFFFFF", type: ShadingType.CLEAR },
          margins: { top: 80, bottom: 80, left: 120, right: 120 },
          children: [new Paragraph({
            alignment: ci === 0 ? AlignmentType.LEFT : AlignmentType.CENTER,
            children: [new TextRun({ text: cell, size: 20, font: "Arial" })]
          })]
        }))
      }))
    ]
  });
}

